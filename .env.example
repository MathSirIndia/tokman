# ==============================================================================
# DISTRIBUTED AI GATEWAY MESH: ENVIRONMENT CONFIGURATION
# ==============================================================================

# Master Gateway Access Key
LITELLM_MASTER_KEY=sk-master-internal-network-key

# PostgreSQL 16 Persistence Credentials
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway_secure_pass_replace_me
POSTGRES_DB=litellm

# Redis Cache & Coordination Endpoint
REDIS_HOST=redis
REDIS_PORT=6379

# Upstream Free-Tier Provider API Keys
GROQ_API_KEY=gsk_replace_with_your_actual_groq_key
CEREBRAS_API_KEY=csk_replace_with_your_actual_cerebras_key
GEMINI_API_KEY=AIzaSy_replace_with_your_actual_gemini_key

# Node Identity & Auto-Tuning
NODE_NAME=Local-Hub
AUTO_APPROVE_TUNING=false

# Cgroup Resource Caps (Stage 2: Standard Edge Defaults)
MEM_LIMIT_LITELLM=512M
MEM_LIMIT_INTERCEPTOR=160M
MEM_LIMIT_POSTGRES=256M
MEM_LIMIT_REDIS=128M
MEM_LIMIT_SEARXNG=80M
MEM_LIMIT_CONDUCTOR=200M
MEM_LIMIT_WEBUI=512M
MEM_LIMIT_ADMIN=128M
MEM_LIMIT_GRAFANA=128M
MEM_LIMIT_BASTION=100M
